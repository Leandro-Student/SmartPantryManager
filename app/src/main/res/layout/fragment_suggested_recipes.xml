<?xml version="1.0" encoding="utf-8"?>
<!-- Layout for the Suggested Recipes screen: a list plus a centered empty-state message. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SuggestedRecipesFragment">

    <!-- The scrolling list of matching recipes. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recipesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        tools:listitem="@layout/item_recipe" />

    <!-- Shown in the middle of the screen when no recipe matches the pantry. -->
    <TextView
        android:id="@+id/emptyStateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:text="No recipes match your pantry yet - add more ingredients"
        android:textSize="18sp"
        android:visibility="gone" />

</FrameLayout>